    <!-- 0.8: Samsung Health über Health Connect -->
    <string name="hc_titel">Samsung Health</string>
    <string name="hc_erklaerung">Gewicht und verbrannte Kalorien kann die App aus Samsung Health übernehmen. Das läuft über „Health Connect“ von Android. Die App liest nur, sie schreibt nichts zurück.</string>
