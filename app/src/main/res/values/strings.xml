    <string name="hc_verbrannt">Verbrannte Kalorien zählen aus</string>
    <string name="hc_quelle_app">Dieser App</string>
    <string name="hc_quelle_hc">Samsung Health</string>
    <string name="hc_quelle_beide">Beidem</string>
    <string name="hc_erlaubnis_hinweis">Damit das klappt, braucht die App einmal deine Erlaubnis. In Samsung Health muss außerdem unter Einstellungen → Health Connect das Teilen eingeschaltet sein.</string>
    <string name="hc_verbinden">Mit Samsung Health verbinden</string>
    <string name="hc_verbunden">Verbunden. Die Werte werden beim Start der App übernommen.</string>
