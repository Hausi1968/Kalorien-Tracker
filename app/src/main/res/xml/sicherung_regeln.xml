<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 und neuer: Die Datenbank (mit 100.000 Katalog-Produkten zu groß, Grenze 25 MB) wird nicht
     gesichert, dafür die kleine Datei files/sicherung/sicherung.json mit allen eigenen Daten. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kalorien.db" />
        <exclude domain="database" path="kalorien.db-wal" />
        <exclude domain="database" path="kalorien.db-shm" />
        <exclude domain="database" path="kalorien.db-journal" />
        <exclude domain="sharedpref" path="katalog.xml" />
        <exclude domain="sharedpref" path="aktualisierung.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="kalorien.db" />
        <exclude domain="database" path="kalorien.db-wal" />
        <exclude domain="database" path="kalorien.db-shm" />
        <exclude domain="database" path="kalorien.db-journal" />
        <exclude domain="sharedpref" path="katalog.xml" />
        <exclude domain="sharedpref" path="aktualisierung.xml" />
    </device-transfer>
</data-extraction-rules>
